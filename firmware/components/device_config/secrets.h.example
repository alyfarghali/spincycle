// Template for secrets.h (dev Wi-Fi credentials). Copy to secrets.h, which is git-ignored.
//
// Dev-only fallback used when NVS has no Wi-Fi credentials. Production devices get
// Wi-Fi, MQTT password, device ID and fleet ID from tools/provision.py, never from here.
// Do not put the MQTT password in this file: one firmware image must work on every device.

#pragma once

#define DEV_WIFI_SSID     "your-ssid"
#define DEV_WIFI_PASSWORD "your-password"
