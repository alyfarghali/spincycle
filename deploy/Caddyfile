# Plain HTTP: in production the server's edge Caddy terminates HTTPS and forwards here.
:80 {
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/web
		# The React app routes /f/... and /m/... itself.
		try_files {path} /index.html
		file_server
	}
}
