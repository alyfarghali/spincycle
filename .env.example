# Every environment variable the stack needs, with placeholder values. Real values live only in .env on the server.
# Copy to .env (git-ignored) and replace every value. Generate passwords with: openssl rand -hex 32

# --- Broker (Mosquitto) ---
# Directory holding fullchain.pem and privkey.pem. Unset locally to use broker/certs/dev.
# BROKER_CERT_DIR=/srv/spincycle/broker-certs
MQTT_ADMIN_PASSWORD=change-me
MQTT_INGEST_PASSWORD=change-me
MQTT_API_PASSWORD=change-me
MQTT_LOADGEN_PASSWORD=change-me

# Public hostname. Used by broker/certs/sync-certs.sh in production.
DOMAIN=spincycle.example.com

# Database
POSTGRES_DB=spincycle
POSTGRES_USER=spincycle
POSTGRES_PASSWORD=change-me

# --- Ingest service ---
# Values for running ingest on the host from the repo root. Inside Compose these become
# mqtt://mosquitto:1883 and postgres://...@postgres:5432/...
INGEST_BROKER_URL=mqtts://localhost:8883
# CA that signed the broker certificate. Relative to the repo root. Optional: unset uses
# the system CAs (production Let's Encrypt cert); not used at all for mqtt:// URLs.
INGEST_CA_FILE=broker/certs/dev/ca.pem
# Fixed client ID: the broker holds this ID's persistent session while ingest restarts.
INGEST_CLIENT_ID=ingest-1
# Username for MQTT_INGEST_PASSWORD (above).
INGEST_MQTT_USER=ingest
# Must use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgres://spincycle:change-me@localhost:5432/spincycle
